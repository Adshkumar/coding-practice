1046. Last Stone Weight

class Solution {
public:
    int lastStoneWeight(vector<int>& stones) {
        vector<int> list;

        for(int stone : stones){
            list.push_back(stone);
        }

        while(list.size() > 2){
            sort(list.begin() , list.end());

           int stone1 = list.back(); 
                        list.pop_back();   

            int stone2 = list.back();
                         list.pop_back();

            if( stone1 == stone2){
                continue;
            }
            list.push_back(stone1 - stone2);
        }
        return list.size() == 0 ? 0 : list[0];
    }
    // return 0;
};


class Solution {
public:
    int lastStoneWeight(vector<int>& stones) {
        // vector<int> list;

        priority_queue<int> pq;
        for(int stone : stones){
            pq.push(stone);
        }
        while(pq.size() > 1){
            // sort(list.begin(), list.end());

            int stone1 = pq.top();
                         pq.pop();

            int stone2 = pq.top();
                         pq.pop();

            if(stone1 == stone2){
                continue;
            }
            pq.push(stone1 - stone2);
        }
        return pq.size() == 0 ? 0 : pq.top();
    }
};

295. Find Median from Data Stream

class MedianFinder {
public:
    vector<int> list;
    MedianFinder() {
        
    }
    
    void addNum(int num) {
        list.insert(lower_bound(list.begin(), list.end(), num), num);
    }
    
    double findMedian() {
        int n = list.size();

        if(n % 2 == 1){
            return list[n/2];
        } else{
            return (list[n/2] + list[n/2 - 1]) / 2.0;
        }
    }
};


class MedianFinder {
public:
    priority_queue<int> maxheap;
    priority_queue<int, vector<int>, greater<int>> minheap;
    MedianFinder() {
        
    }
    
    void addNum(int num) {
        maxheap.push(num);
        minheap.push(maxheap.top());
        maxheap.pop();

        if(minheap.size() > maxheap.size()){
            maxheap.push(minheap.top());
            minheap.pop();
        }
    }
    
    double findMedian() {
        if(maxheap.size() > minheap.size()){
            return maxheap.top();
        }
        return (maxheap.top() + minheap.top()) / 2.0;
    }
};

2402. Meeting Rooms III

class Solution {
public:
    int mostBooked(int n, vector<vector<int>>& meetings) {

        // sort by start time
        sort(meetings.begin(), meetings.end(), [](auto &a, auto &b){
            return a[0] < b[0];
        });

        vector<long long> endTime(n, 0); // when room becomes free
        vector<int> count(n, 0);         // meeting count

        for(int i = 0; i < meetings.size(); i++){
            int start = meetings[i][0];
            int end = meetings[i][1];

            int minEndIdx = 0;
            bool allocated = false;

            for(int room = 0; room < n; room++){
                // if room is free
                if(start >= endTime[room]){
                    endTime[room] = end;
                    count[room]++;
                    allocated = true;
                    break;
                }

                // track room with earliest end time
                if(endTime[room] < endTime[minEndIdx]){
                    minEndIdx = room;
                }
            }

            // if no room free → delay meeting
            if(!allocated){
                endTime[minEndIdx] += (end - start);
                count[minEndIdx]++;
            }
        }

        // find room with max meetings
        int ans = 0;
        for(int i = 1; i < n; i++){
            if(count[i] > count[ans]){
                ans = i;
            }
        }

        return ans;
    }
};


Binary Search Pattern

1. Two Sum


class Solution {
public:
    vector<int> twoSum(vector<int>& nums, int target) {
        int n = nums.size();

        for(int i=0; i<n-1; i++){
            for(int j=i+1; j<n; j++){
                if(nums[i] + nums[j] == target){
                    return {i, j};
                }
            }
        }
        return {};
    }
};


34. Find First and Last Position of Element in Sorted Array

class Solution {
public:
    vector<int> searchRange(vector<int>& nums, int target) {
        int first = -1, last = -1;

        for(int i =0; i<nums.size(); i++){
            if(nums[i] == target){
                if(first == -1){
                    first = i;
                }
                last = i;
            }
        }
        return {first, last};
    }
};

// second approach

class Solution {
public:
    vector<int> searchRange(vector<int>& nums, int target) {
        int low = 0, high = nums.size() -1;
        int first = -1;
        while(low <= high){
            int mid = (low + high )/2;

            if(nums[mid] == target){
                first = mid, high = mid - 1;
            } else if(nums[mid] < target){
                low = mid +1;
            } else{
                high = mid - 1;
            }
        }

        low = 0; 
        high = nums.size() - 1;
        int last = -1;
        while(low <= high){
            int mid = (low + high) / 2;

            if(nums[mid] == target){
                last = mid, low = mid + 1;
            } else if(nums[mid] < target){
                low = mid + 1;
            } else{
                high = mid - 1;
            }
        }
        return{first , last};
    }
};

153. Find Minimum in Rotated Sorted Array

class Solution {
public:
    int findMin(vector<int>& nums) {
        int left = 0, right = nums.size() -1;
        while(left < right){
            int mid = (left + right ) /2;
            if(nums[mid] > nums[right]){
                left = mid + 1;
            } else{
                right = mid;
            }
        }
        return nums[left];
    }
};

875. Koko Eating Bananas

class Solution {
public:
    int minEatingSpeed(vector<int>& piles, int h) {
        int left = 1, right = 1;
        for(int pile: piles){
            right = max(right, pile);
        }
        while(left < right){
            int mid = (left + right)/ 2;
            long long hours = 0;

            for(int pile: piles){
                hours += (pile + mid -1) / mid;
            }
            if(hours <= h){
                right = mid;
            } else{
                left = mid + 1;
            }
        }
        return left;
    }
};

215. Kth Largest Element in an Array

class Solution {
public:
    int findKthLargest(vector<int>& nums, int k) {
        priority_queue<int> pq (nums.begin(), nums.end());
        for(int i =0; i<k-1; i++){
            pq.pop();
        }
        return pq.top();
    }
};

378. Kth Smallest Element in a Sorted Matrix

class Solution {
public:
    int kthSmallest(vector<vector<int>>& matrix, int k) {
        priority_queue<int> maxheap;
        int n = matrix.size();

        for(int i=0; i<n; i++){
            for(int j=0; j<n; j++){
                maxheap.push(matrix[i][j]);

                if(maxheap.size() > k){
                maxheap.pop();
            }
        }
        }
        return maxheap.top();
    }
};

23. Merge k Sorted Lists

class Solution {
public:
    ListNode* mergeKLists(vector<ListNode*>& lists) {
        vector<int> values;
        for(auto node: lists){
            while(node != NULL){
                values.push_back(node->val);
                node = node->next;
            }
        }
            sort(values.begin(), values.end());
            ListNode* dummy = new ListNode(0);
            ListNode* temp = dummy;

            for(int val: values){
                temp->next = new ListNode(val);
                temp = temp->next;
            }
        return dummy->next;
    }
};

973. K Closest Points to Origin

class Solution {
public:
    vector<vector<int>> kClosest(vector<vector<int>>& points, int k) {
        sort(points.begin(), points.end(), [](vector<int>& a, vector<int>& b){
            int d1 = a[0] * a[0] + a[1] * a[1];
            int d2 = b[0] * b[0] + b[1] * b[1];
            return d1 < d2;
        });
         vector<vector<int>> res;
            for(int i=0; i < k; i++){
                res.push_back(points[i]);
            } 
        
        return res;
    }
};

1283. Find the Smallest Divisor Given a Threshold

class Solution {
public:
    int smallestDivisor(vector<int>& nums, int threshold) {
        int left = 1;
        int right = *max_element(nums.begin(), nums.end());

        while(left < right){
            int mid = (left + right) / 2;
            int sum = 0;

            for(int num : nums){
                sum += (num + mid -1) / mid;
            }
            if(sum <= threshold){
                right = mid;
            } else{
                left = mid +1;
            }
        }
        return left;
    }
};

1011. Capacity To Ship Packages Within D Days

class Solution {
public:
    int shipWithinDays(vector<int>& weights, int days) {
        int maxWeight = -1, totalWeight = 0;
        for(int weight: weights){
            maxWeight =  max(maxWeight, weight);
            totalWeight = totalWeight + weight;
        }
        while(maxWeight < totalWeight){
            int midWeight = (maxWeight + totalWeight) / 2;
            int daysNeed = 1, currWeight = 0;
            for(int weight : weights){
                if(currWeight + weight > midWeight){
                    daysNeed++;
                    currWeight = 0;
                }
                currWeight = currWeight + weight;
            }
            if(daysNeed > days ){
                maxWeight = midWeight + 1;
            } else{
                totalWeight = midWeight;
            }
        }
        return maxWeight;
    }
};

1539. Kth Missing Positive Number

class Solution {
public:
    int findKthPositive(vector<int>& arr, int k) {
        for(int i=0; i<arr.size(); i++){
            if(arr[i] <= k){
                k++;
            }
        }
        return k;
    }
};

class Solution {
public:
    int findKthPositive(vector<int>& arr, int k) {
        int low = 0, high = arr.size() -1;
        while(low <= high){
            int mid = (low + high ) / 2;
            int miss = arr[mid] - (mid + 1);

            if(miss < k){
                low = mid + 1;
            } else{
                high = mid -1;
            }
        }
        return low + k;
    }
};